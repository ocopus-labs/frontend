PUBLIC_API_BASE=http://localhost:3000/api/v1
PUBLIC_SUPPORT_EMAIL=support@yourdomain.com

# Backend API URL (used for webhook URL display in payment credentials settings)
# Leave empty for dev (will auto-detect from window.location)
# Set to your backend's public URL in production, e.g., https://api.yourdomain.com
PUBLIC_BACKEND_URL=

PUBLIC_CUSTOMER_AUTH_BASE=http://localhost:3000/api/customer-auth

# Map tiles for LocationMap (franchise location maps).
# Defaults to OpenStreetMap's public tile servers, which are fine for dev and
# light use but are NOT intended for heavy commercial traffic — move to a paid
# host (MapTiler / Stadia / Protomaps) before real scale. Changing provider is
# just these two vars; no code change.
PUBLIC_MAP_TILE_URL=
PUBLIC_MAP_TILE_ATTRIBUTION=
